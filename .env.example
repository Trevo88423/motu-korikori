# Supabase Configuration
# Get these from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# For server-side operations (seeding, admin tasks)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Cloudflare R2 Audio Upload Worker
# Deploy the worker from /worker/audio-upload/ and put the URL here
NEXT_PUBLIC_R2_UPLOAD_URL=https://your-audio-worker.your-subdomain.workers.dev

# Optional: Analytics
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=your-domain.com

# Optional: Error tracking
# SENTRY_DSN=https://xxx@sentry.io/xxx
