# Supabase Configuration
# Get these from your Supabase project settings (https://supabase.com/dashboard)

# Project URL (found in Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Anonymous/Public Key (found in Settings > API)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service Role Key (found in Settings > API - keep this secret!)
# Only use this in server-side code, NEVER expose to client
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Cloudflare R2 Configuration (for audio uploads)
# Get these from your Cloudflare dashboard after setting up R2

# Cloudflare Worker URL for audio uploads
NEXT_PUBLIC_CLOUDFLARE_WORKER_URL=https://audio-upload.your-worker.workers.dev

# Instructions:
# 1. Copy this file to .env.local
# 2. Fill in your actual values
# 3. Never commit .env.local to version control
